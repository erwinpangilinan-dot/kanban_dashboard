# Windows / Docker Desktop only. This stack needs both compose files, and a plain
# "docker compose up" loads just the base one — which recreates Postgres without a
# published port and silently breaks the host poller. Setting it here makes the
# short command equivalent to passing both -f flags. Semicolon separates paths on
# Windows; use a colon on Linux, or leave this unset there (the override is
# Desktop-specific).
# COMPOSE_FILE=docker-compose.yml;docker-compose.windows.yml

# Database (used by api service in Docker; override for local dev)
DATABASE_URL=postgresql://kanban:kanban@localhost:5432/mission_control

# Postgres credentials for the Docker service. Defaults to kanban/kanban.
# POSTGRES_PASSWORD only takes effect when the data volume is first created —
# to rotate on an existing volume, ALTER USER inside the container, then set it
# here and in DATABASE_URL. In Docker the port is bound to 127.0.0.1, so the
# database is not reachable from the LAN.
# POSTGRES_USER=kanban
# POSTGRES_PASSWORD=
# POSTGRES_DB=mission_control

# Backend
PORT=3001
NODE_ENV=development
MIGRATIONS_DIR=

# Auth (optional in dev — set JWT_SECRET to enable; API/MCP use AUTH_API_TOKEN)
# With NODE_ENV=production the API refuses to start unless JWT_SECRET is set, because
# an unset secret otherwise serves every /api route unauthenticated. To deliberately
# run an open API in production, set ALLOW_UNAUTHENTICATED=1.
JWT_SECRET=
# AUTH_USERNAME/AUTH_PASSWORD seed the FIRST admin account only, and only while the
# users table is empty. After that, accounts live in the database and are managed in
# the dashboard Users tab, so changing these values here has no effect. Locked out?
#   npm run user:reset-password --prefix backend -- <username> <password>
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Static bearer token for MCP servers and scripts. Not a dashboard account: it
# bypasses the users table with full access to every tab.
AUTH_API_TOKEN=
# ALLOW_UNAUTHENTICATED=1
# Failed logins are rate limited per client IP; successful ones are not counted.
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Number of reverse proxies in front of the API, so req.ip is the real caller
# and the login limiter cannot be evaded with a spoofed X-Forwarded-For.
# Leave at 1 even behind a Cloudflare Tunnel: nginx resolves the real visitor
# and forwards exactly one address, so the API still sees a single hop.
# TRUST_PROXY_HOPS=1

# Browser origins allowed to call the API cross-origin. The bundled UI is served
# from the same origin and needs none of these. Unset means: development allows
# any origin (for the Vite dev server), production allows none.
# CORS_ALLOWED_ORIGINS=https://mc.example.com

# MCP (Cursor agent → Mission Control API)
# Production is source of truth for status; local Docker is dev-only (separate DB).
MISSION_CONTROL_API_URL=http://10.10.50.6/api
# MISSION_CONTROL_API_TOKEN defaults to AUTH_API_TOKEN in mcp/run.sh

# Frontend (Vite dev server only)
VITE_API_URL=http://localhost:3001

# ── Sprint 2: Telegram (Done + overdue + urgent only) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ON=completed,overdue,urgent
TELEGRAM_OVERDUE_CHECK_HOURS=24

# ── Sprint 2: Email daily digest ──
# Gmail API (preferred when GOOGLE_REFRESH_TOKEN is set) or SMTP fallback
GOOGLE_REFRESH_TOKEN=
GOOGLE_SEND_AS=
EMAIL_FROM=
EMAIL_TO=
EMAIL_DIGEST_CRON="0 8 * * 1-5"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Google Workspace MCP (Cursor agent Gmail/Calendar/Drive) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Workspace email assistant (local Ollama) ──
# Linux Docker: host.docker.internal:11435 (ollama-proxy / socat)
# Windows Docker Desktop: host.docker.internal:11434 (direct; no host-network proxy)
# Production: shared dev Ollama at http://10.10.1.55:11435
OLLAMA_BASE_URL=http://host.docker.internal:11435
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_MS=120000

# ── Sprint 3: GitHub (manual link + auto-create issues) ──
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_DEFAULT_REPO=your-org/your-repo
GITHUB_AUTO_CREATE=true
MISSION_CONTROL_PUBLIC_URL=http://localhost

# Google OAuth redirect for Workspace "Re-authenticate" button:
# Add this URI in Google Cloud Console → OAuth client → Authorized redirect URIs:
#   {MISSION_CONTROL_PUBLIC_URL}/api/workspace/oauth/callback
# Example local: http://localhost/api/workspace/oauth/callback

# ── Cloudflare Tunnel (public hostname without opening a firewall port) ──
# Start with: docker compose --profile cloudflare -f docker-compose.yml -f docker-compose.windows.yml up -d
# Token comes from Zero Trust → Networks → Tunnels → your tunnel → Docker.
# Route the tunnel's public hostname to http://web:8080 — port 8080 is the
# tunnel-only nginx listener, which is what lets the API see real visitor IPs.
# Treat the token as a credential: it alone is enough to run the tunnel.
# Set MISSION_CONTROL_PUBLIC_URL to the https hostname and add the matching
# OAuth redirect URI above, or Workspace re-authentication will fail.
# CLOUDFLARE_TUNNEL_TOKEN=

# ── Memoria Graph (dashboard sidebar) ──
# HTTP API the Mission Control API proxy uses for /api/memoria/graph
# Shared LAN service (typical): http://10.10.50.2:8765
# Local Memoria on the same machine: http://host.docker.internal:8765 (must listen on 0.0.0.0:8765)
MEMORIA_API_URL=http://10.10.50.2:8765

# ── Network equipment (vDU / BMC Redfish) ──
# Google Sheet ID for vDU_List (Network_Information folder)
NETWORK_VDU_SHEET_ID=1CpfPlE12oGDIxsJJ8HoeAMXevF7nDAgRTlDoyhoWjsk
# Poll BMC TCP/Redfish every N ms; re-sync sheet every N ms
NETWORK_PROBE_INTERVAL_MS=45000
NETWORK_SYNC_INTERVAL_MS=300000
# Redfish credentials are stored in Workspace settings (UI → Network → Settings),
# keyed by vendor (e.g. DELL). BMC TLS uses self-signed certs (verify disabled).
# Docker Desktop/WSL2: API containers often lack IPv6 LAN routes (ENETUNREACH to BMC).
# windows compose sets NETWORK_SKIP_CONTAINER_POLLER=1 and start-windows.ps1 launches
# backend/scripts/network-host-poller.js on the host (Postgres published on :5432).
# Host agent also serves POST /reboot and POST /precheck on :38765 for Network tab actions.
# NETWORK_HOST_AGENT_URL=http://host.docker.internal:38765
# NETWORK_REBOOT_VIA_HOST=1
# NETWORK_PRECHECK_VIA_HOST=1
# Directory containing <cluster_name>.kubeconfig files (e.g. rcnltxaa-s1372466-069.kubeconfig).
# Defaults to ./secrets/kubeconfigs, which is gitignored — kubeconfigs embed client keys.
# NETWORK_KUBECONFIG_DIR=/path/to/kubeconfigs
# KUBECTL_PATH=kubectl
# Wind River subcloud SSH (precheck via system/kubectl over SSH)
# Credentials are per Parent Central Controller in Network → Settings (sync vDU_List first).
# Default fallback env vars below apply when no per-controller password is saved:
# NETWORK_WR_SSH_USER=sysadmin
# NETWORK_WR_SSH_PASSWORD=
# NETWORK_WR_SSH_KEY_PATH=/path/to/wr_subcloud_key
# Or save credentials in Network → Settings → Wind River SSH
# Precheck logs: logs/subcloud-precheck/<gNB DUID>/<timestamp>.log (override with NETWORK_PRECHECK_LOG_DIR)
# NETWORK_PRECHECK_LOG_DIR=
# Refresh Subcloud IP / Cluster name from Far-Edge middleware (Fuze SiteID column in vDU_List)
NETWORK_SUBCLOUD_MIDDLEWARE_URL=https://middleware.faredge.vzwops.com/caas/subcloud/
NETWORK_SUBCLOUD_MIDDLEWARE_ENABLED=1
# Subcloud Fuze lookup (/caas/subcloud/) needs no AD login — CSRF only.
# Username/password are only for orchestration connection-details / setup-cluster (Basic auth).
NETWORK_SUBCLOUD_MIDDLEWARE_USERNAME=
# Quote if the password contains # (dotenv treats unquoted # as a comment and truncates).
# Example: NETWORK_SUBCLOUD_MIDDLEWARE_PASSWORD="p@ssw0rd#"
NETWORK_SUBCLOUD_MIDDLEWARE_PASSWORD=
NETWORK_SUBCLOUD_MIDDLEWARE_DOMAIN=USWIN
# On Windows Docker Desktop the API container often cannot resolve/reach middleware — proxy via host poller:
NETWORK_SUBCLOUD_MIDDLEWARE_VIA_HOST=1
# Optional override for orchestration connection-details (defaults to middleware host origin):
# NETWORK_ORCHESTRATION_BASE_URL=https://middleware.faredge.vzwops.com
# Samsung Atlas precheck: proxy API calls via host poller (reads .env without Compose $ interpolation)
NETWORK_ATLAS_VIA_HOST=1
# Write middleware-enriched fields back to vDU_List on Google Drive (set 0 to disable)
# NETWORK_VDU_SHEET_WRITEBACK=0
NETWORK_HOST_AGENT_URL=http://host.docker.internal:38765
# REQUIRED to run the host agent. It can reboot hardware and launch Atlas jobs, and it
# must bind a LAN-visible interface so the API container can reach it, so this shared
# secret is what keeps other hosts out. The API and the poller must see the same value.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NETWORK_HOST_AGENT_TOKEN=
# Bind address for the host agent. Keep 0.0.0.0 for Docker Desktop (host.docker.internal
# does not reach loopback); use 127.0.0.1 when the API runs directly on this host.
# NETWORK_HOST_AGENT_BIND=0.0.0.0
NETWORK_SKIP_CONTAINER_POLLER=1
NETWORK_PRECHECK_VIA_HOST=1
NETWORK_REBOOT_VIA_HOST=1
# ZT Proteus BMC reset uses ipmitool on the host poller (Ubuntu WSL: apt install ipmitool)
# IPMITOOL_PATH=wsl -d Ubuntu-24.04 ipmitool
# Samsung UDU/VDU application precheck via Atlas (Pods tab → Samsung precheck)
# NETWORK_ATLAS_BASE_URL=http://me.atlas.automation.vzwnet.com
# Preferred when password auth fails — paste a personal access / OAuth bearer token.
# Can also be updated from Network → Settings (UI) without editing this file:
# NETWORK_ATLAS_BEARER_TOKEN=
# Or username/password (Basic auth / token exchange):
# NETWORK_ATLAS_USERNAME=
# NETWORK_ATLAS_PASSWORD=
# Optional: domain login (e.g. USWIN\\panger6) when Basic auth requires domain prefix
# NETWORK_ATLAS_DOMAIN=USWIN
# NETWORK_ATLAS_AUTH_USERNAME=
# Docker env_file treats $ specially — escape as $$ (e.g. pa$$word)
# NETWORK_ATLAS_BATCH_USERNAME=  # optional; defaults to NETWORK_ATLAS_USERNAME (batch_list userName)
# NETWORK_ATLAS_UDU_TEMPLATE_ID=7491
# NETWORK_ATLAS_VDU_TEMPLATE_ID=6578
# Samsung UDU/VDU undeployment (Pods tab → Samsung undeployment) — Atlas workflow_job_templates
# NETWORK_ATLAS_UDU_UNDEPLOY_TEMPLATE_ID=5666
# NETWORK_ATLAS_VDU_UNDEPLOY_TEMPLATE_ID=10237
# Samsung UDU/VDU deployment (Pods tab → Samsung deployment) — Atlas workflow_job_templates
# NETWORK_ATLAS_UDU_DEPLOY_TEMPLATE_ID=8784
# NETWORK_ATLAS_VDU_DEPLOY_TEMPLATE_ID=6746
# Optional: default ciqSource preselected in the Pods tab "CIQ source" dropdown.
# Operators can override it per launch; only MARKET_PLACE and CONQUEST_LAB are accepted.
# NETWORK_ATLAS_DEPLOY_CIQ_SOURCE=MARKET_PLACE
